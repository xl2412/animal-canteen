APP_ENV=development
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=animal-canteen/device
FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated production origins, for example a Railway and a Vercel domain.
FRONTEND_ORIGINS=
DATABASE_URL=postgresql+asyncpg://animal:animal_dev@localhost:5432/animal_canteen
# Railway may provide postgresql://...; the application normalizes it automatically.
JWT_SECRET=change-me
